load("@rules_proto//proto:defs.bzl", "proto_library")
load("@io_bazel_rules_go//proto:def.bzl", "go_proto_library")
load("@io_bazel_rules_go//go:def.bzl", "go_library")

proto_library(
    name = "challenge_proto",
    srcs = ["challenge.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/googleapis/google/api:annotations_proto",
    ],
)

go_proto_library(
    name = "challenge_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "github.com/corvad/pow/api/proto/challenge/v1",
    proto = ":challenge_proto",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "verifier_proto",
    srcs = ["verifier.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//third_party/googleapis/google/api:annotations_proto",
    ],
)

go_proto_library(
    name = "verifier_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "github.com/corvad/pow/api/proto/verifier/v1",
    proto = ":verifier_proto",
    visibility = ["//visibility:public"],
)
